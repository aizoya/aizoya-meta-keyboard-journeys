# Development defaults. This file contains no credential.
HOST=127.0.0.1
PORT=8787
# Leave blank locally; set only to the approved external HTTPS origin.
PUBLIC_ORIGIN=
MODEL_API_KEY=
# Server-only credentials for the isolated, persistent judge budget ledger.
META_BUDGET_SUPABASE_URL=
META_BUDGET_SUPABASE_SERVICE_ROLE_KEY=
# Live inference requires both the Meta key and budget ledger. Calls reserve $0.05 atomically.
PASSAGE_ENABLE_META=0
PASSAGE_MAX_META_CALLS=0
