FROM mcr.microsoft.com/playwright:v1.62.1-noble
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY server.mjs runner.mjs policy.mjs meta.mjs ./
COPY public ./public
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY third-party ./third-party
ENV HOST=0.0.0.0 PORT=8787 PASSAGE_ENABLE_META=0 PASSAGE_MAX_META_CALLS=0
EXPOSE 8787
CMD ["node","server.mjs"]
